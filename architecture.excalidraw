      "x": 430,
      "y": 95,
      "width": 160,
      "height": 25,
      "text": "Qwen2.5-VL (3B)",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "center",
      "strokeColor": "#2f9e44"
    },
    {
      "id": "vlm-subtitle",
