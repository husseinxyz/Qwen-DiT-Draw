      "id": "title",
      "type": "text",
      "x": 500,
      "y": 10,
      "width": 300,
      "height": 35,
      "text": "Qwen-DiT-Draw Architecture",
      "fontSize": 28,
      "fontFamily": 1,
      "textAlign": "center",
      "strokeColor": "#1e1e1e"
