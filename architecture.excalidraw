      "x": 550,
      "y": 395,
      "width": 200,
      "height": 20,
      "text": "Visual Feedback Loop",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "strokeColor": "#5c7cfa"
